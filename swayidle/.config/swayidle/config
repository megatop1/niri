# Dim display after 2.5 minutes
timeout 150 'brightnessctl -s set 10' resume 'brightnessctl -r'

# Turn off keyboard backlight after 2.5 minutes
timeout 150 'brightnessctl -sd rgb:kbd_backlight set 0' resume 'brightnessctl -rd rgb:kbd_backlight'

# Lock session after 5 minutes
timeout 300 'noctalia msg session lock'

# Turn off monitors after 5.5 minutes
timeout 330 'noctalia msg dpms-off' resume 'noctalia msg dpms-on && brightnessctl -r'

# Suspend after 30 minutes
timeout 1800 'systemctl suspend'

# Lock before system sleep
before-sleep 'noctalia msg session lock'
